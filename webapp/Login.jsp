<!DOCTYPE html>
<html>
<head>
    <title>Student Login</title>
</head>
<body>

    <h1>Student Login</h1>

    <form action="login" method="post">

        Student ID:
        <input type="number" name="studentId" required>
        <br><br>

        Password:
        <input type="password" name="password" required>
        <br><br>

        <button type="submit">Login</button>

    </form>

</body>
</html>